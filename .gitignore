# File Description: Git ignore configuration for temporary assets, build outputs, and node_modules.

node_modules
dist
.DS_Store
.env

# Rendered video.
out

# Proof stills and large frame sequence directories.
.frames/
.tmp_audio/
public/.tmp_audio/
public/tea1_motion/
public/graph_motion/
public/robot_frames/
public/gpu_robot_arm/

# Personal videos are never committed: whoever forks this repo makes their own. Every package
# (film.json, script, voiceover, footage, visuals, design state) lives under videos/<slug>/, or
# anywhere else AIDEOS_VIDEOS_DIR points. Only examples/ ships, as the read-only fallback.
/videos/*
!/videos/.gitkeep
!/videos/README.md

# Generated from the packages on disk by scripts/ensure_generated.ts (npm postinstall and the
# pre-hooks of test, lint, studio, render): per-film TS shadows for Remotion's CLI bundle, the
# bundled SVG source map and the pointer at the film that renders.
/src/dl/films/*
!/src/dl/films/README.md
/src/dl/activeFilm.ts
/src/dl/scene/assets/svgSources.generated.ts

# Preview copies of the film being edited, personal media and agent review artifacts.
/public/film.json
/public/captions*.vtt
/public/media/
/public/*.png
!/public/favicon.png
/src/voiceover.wav
/.lavish/

# Media is kept out of the repository on purpose: it is large, it is not the
# source of truth for anything, and licensed tracks should not be redistributed
# with the code. Drop your own files into public/ and name them in the Studio
# props panel: see CLAUDE.md.
public/*.mp3
public/*.wav
public/*.m4a
public/*.mp4
public/*.mov
*.wav
*.mp3
*.m4a
*.mp4
*.mov

# Transitions directory
transitions/
public/transitions/
public/footage/

# GPU-rendered b-roll clips from staged assemble runs: large binaries, kept out
# of the repository like all media (see the note above).
production/*/footage/

# Runtime and local conversation state
data/

# Temporary and local user scripts
scripts/*.md
scripts/*.txt
scripts/*.json
scripts/*.py
scripts/*.mjs
# The agent connector is served to users at /api/agent-link/connect.mjs, so it must ship.
!scripts/aideos-connect.mjs

# Local Agent Director session and dispatch state backend/agentPrompter.ts writes to the
# repo root: which coding agent/tmux pane is connected, and the log of prompts dispatched
# to it. Regenerated per machine; never something to commit.
/.aideos_session.json
/.aideos_task.md
/state/agent_events.jsonl


# Design build results written next to a committed example package are per machine too.
examples/*/design/status.json
examples/*/design/motion-requests.json
examples/*/design/history/
examples/*/design/BRIEF.md
examples/*/run-state.json
examples/*/narration.json
examples/*/footage/

# Agent link pairings (hashed secrets) for aideos connect.
.aideos/

# Gemini video review reports and round state
videos/*/gemini-review/
videos/*/review.json
videos/*/review-loop.json
