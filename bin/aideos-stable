#!/usr/bin/env bash
# File Description: Pinned stable dispatcher that cannot switch to the caller's updating checkout.
# Inputs and outputs: stable command and arguments -> stable checkout CLI or film copy tool.
# Used by: release setup launchers and aideos-stable copy-film.

set -euo pipefail
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
  base="$(cd "$(dirname "$target")" && pwd -P)"
  link="$(readlink "$target")"
  case "$link" in /*) target="$link" ;; *) target="$base/$link" ;; esac
done
root="$(cd "$(dirname "$target")/.." && pwd -P)"
export AIDEOS_PINNED_ROOT="$root"
export AIDEOS_PROJECT_ROOT="$root"
export AIDEOS_VIDEOS_DIR="$root/videos"
if [ "${1:-}" = copy-film ]; then
  shift
  "$root/node_modules/.bin/tsx" "$root/scripts/channel.ts" "$root"
  exec "$root/node_modules/.bin/tsx" "$root/scripts/release.ts" copy-film "$@"
fi
exec "$root/bin/aideos" "$@"
