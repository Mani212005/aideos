#!/usr/bin/env bash
# File Description: Aideos command dispatcher and interactive Studio launcher.
# Inputs and outputs: command-line arguments -> runs the studio, a render, a review or a CLI command.
# Used by: the `bin` field of package.json (entry point on the user's PATH).

set -e

# Project resolution precedence (the one place this is documented):
#   1. Pinned checkout when invoked through a channel launcher (AIDEOS_PINNED_ROOT),
#      preventing a stable or updating launcher from switching checkouts through cwd.
#   2. The checkout containing the current directory (it or any ancestor holds remotion.config.ts and editor/),
#      so working inside another checkout or worktree runs that checkout's code.
#   3. Otherwise the installation root: the checkout this dispatcher itself lives in, found by following
#      its own symlinks (the global ~/.local/bin/aideos link), so the command works from any directory.
# There is no other fallback: a stale hardcoded clone must never be run by accident.

# Returns success when the directory is an Aideos checkout.
is_aideos_checkout() {
  [ -f "$1/remotion.config.ts" ] && [ -d "$1/editor" ]
}

# Prints the absolute real path of a file, following symlinks (portable: no GNU readlink -f).
resolve_real_path() {
  local target="$1" dir link
  while [ -L "$target" ]; do
    dir="$(cd "$(dirname "$target")" && pwd -P)"
    link="$(readlink "$target")"
    case "$link" in
      /*) target="$link" ;;
      *) target="$dir/$link" ;;
    esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$target")" && pwd -P)" "$(basename "$target")"
}

AIDEOS_DIR="${AIDEOS_PINNED_ROOT:-}"
SEARCH_DIR="$(pwd -P)"
while [ -z "$AIDEOS_DIR" ]; do
  if is_aideos_checkout "$SEARCH_DIR"; then
    AIDEOS_DIR="$SEARCH_DIR"
    break
  fi
  [ "$SEARCH_DIR" = "/" ] && break
  SEARCH_DIR="$(dirname "$SEARCH_DIR")"
done
if [ -z "$AIDEOS_DIR" ]; then
  SELF_PATH="$(resolve_real_path "${BASH_SOURCE[0]}")"
  INSTALL_ROOT="$(cd "$(dirname "$SELF_PATH")/.." && pwd -P)"
  if is_aideos_checkout "$INSTALL_ROOT"; then
    AIDEOS_DIR="$INSTALL_ROOT"
  else
    echo "Error: Could not locate the Aideos checkout for $SELF_PATH (expected remotion.config.ts and editor/ in $INSTALL_ROOT)." >&2
    exit 1
  fi
fi

# Derive identity from Git on every invocation; labels cannot be selected by environment.
if [ -x "$AIDEOS_DIR/node_modules/.bin/tsx" ] && [ -f "$AIDEOS_DIR/scripts/channel.ts" ]; then
  AIDEOS_PORT="$("$AIDEOS_DIR/node_modules/.bin/tsx" "$AIDEOS_DIR/scripts/channel.ts" "$AIDEOS_DIR")"
else
  # Help remains usable before npm install; an unverifiable checkout always announces DEV.
  echo "AIDEOS DEV (install dependencies to read Git identity)" >&2
  AIDEOS_PORT=3001
fi

# Reject unknown commands before resolving a checkout or touching Studio state.
if [ "$#" -gt 0 ]; then
  case "$1" in
    version|--version|which|exit|stop|down|kill|validate|review|all-check|connect|design|look|character|render|render:reel|reel|studio|frames|test|lint|produce|engine-test|film|direct|mcp|gemini-review|audio|end-card|help|--help|-h)
      ;;
    *)
      echo "Error: unknown aideos command '$1'." >&2
      echo "Commands: exit (stop/down/kill), validate, review, all-check, connect, design, look, character, render, reel, studio, frames, test, lint, produce, engine-test, film, direct, mcp, gemini-review, audio, help" >&2
      echo "Run 'aideos help' for usage." >&2
      exit 2
      ;;
  esac
fi

# Prints the usage of `aideos design`.
design_usage() {
  echo "Usage: aideos design check <film...> [--all] [--stills] [--json]"
  echo "       aideos design brief <film>"
  echo "       aideos design build <film> [--source agent|server-model|hand-built]"
}

# Prints the usage of `aideos look`.
look_usage() {
  echo "Usage: aideos look brief <film>"
  echo "       aideos look check <film> [--json]"
}

# Prints the usage of `aideos audio`.
audio_usage() {
  echo "Usage: aideos audio fetch [--item <id>] [--force] [--json]"
  echo "       aideos audio verify [--item <id>] [--json]"
  echo "       aideos audio import <id> <file>"
}

CONFIG_DIR="${HOME}/.config/aideos"
CONFIG_FILE="${CONFIG_DIR}/agent"
SESSION_FILE="${AIDEOS_DIR}/.aideos_session.json"
TMUX_SESSION="aideos-$AIDEOS_PORT"

# Subcommand dispatch for non-interactive commands
if [ "$#" -gt 0 ]; then
  CMD="$1"
  shift
  case "$CMD" in
    version|--version|which)
      [ "$CMD" = --version ] && CMD=version
      exec "$AIDEOS_DIR/node_modules/.bin/tsx" "$AIDEOS_DIR/scripts/channel.ts" "$AIDEOS_DIR" "$CMD"
      ;;
    exit|stop|down|kill)
      PIDS=$(lsof -tiTCP:"$AIDEOS_PORT" -sTCP:LISTEN 2>/dev/null || true)
      for PID in $PIDS; do
        # Stop only a server whose working directory is this checkout's editor.
        if lsof -a -p "$PID" -d cwd -Fn 2>/dev/null | grep -Fxq "n$AIDEOS_DIR/editor"; then
          kill "$PID"
        else
          echo "Refusing to stop a different server on port $AIDEOS_PORT." >&2
          exit 1
        fi
      done
      echo "The local host is stopped. Hope you make something amazing!"
      exit 0
      ;;
    validate)
      cd "$AIDEOS_DIR" && npm run validate "$@"
      exit 0
      ;;
    review)
      # aideos review <slug|mp4> [--film film.json] [--words words.json|narration.txt] [--out dir] [--no-ocr] [--json]
      # Exits 1 when a gate of the good-video rubric fails, 2 when the review could not run.
      cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts review "$@"
      ;;
    gemini-review)
      # gemini-review --json must keep npm lifecycle banners off stdout.
      cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts gemini-review "$@"
      ;;
    all-check)
      # aideos all-check <slug> [--reference <mp4>] [--rounds <n>] [--target <score>] [--agent claude|agy] [--model <id>] [--allow-forbidden-model] [--wait]
      # Runs the whole video check (render long and reel, measured and Gemini review, fix, repeat) in a
      # background agent in its own Herdr workspace. Also: all-check status|wait|round|frames|rollback|finish <slug>.
      cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts all-check "$@"
      ;;
    connect)
      # aideos connect <PAIRING-CODE> --agent claude|agy|codex|opencode [--url <studio api url>]
      # Links a studio to the agent in this terminal (defaults to the local studio).
      case " $* " in *" --url "*) exec node "$AIDEOS_DIR/scripts/aideos-connect.mjs" "$@" ;; esac
      exec node "$AIDEOS_DIR/scripts/aideos-connect.mjs" "$@" --url "http://localhost:$AIDEOS_PORT"
      ;;
    design)
      # aideos design check|brief|build <film>
      SUB="${1:-}"
      shift || true
      case "$SUB" in
        check|build|brief)
          cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts "design-$SUB" "$@"
          ;;
        --help|-h|help)
          design_usage
          exit 0
          ;;
        *)
          design_usage >&2
          exit 1
          ;;
      esac
      ;;
    character)
      # aideos character check|sheet <spec...>
      SUB="${1:-}"
      shift || true
      case "$SUB" in
        check|sheet)
          cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts character "$SUB" "$@"
          ;;
        *)
          echo "Usage: aideos character check <spec-or-id...> [--stamp] [--json]" >&2
          echo "       aideos character sheet <spec-or-id> [--out dir] [--placement x,y,units] [--clamp]" >&2
          exit 1
          ;;
      esac
      ;;
    look)
      # aideos look brief|check <film>
      SUB="${1:-}"
      shift || true
      case "$SUB" in
        brief)
          cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts "look-brief" "$@"
          ;;
        check)
          cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts "look-check" "$@"
          ;;
        --help|-h|help)
          look_usage
          exit 0
          ;;
        *)
          look_usage >&2
          exit 1
          ;;
      esac
      ;;
    audio)
      # aideos audio fetch|verify|import ...
      SUB="${1:-}"
      shift || true
      case "$SUB" in
        fetch|verify|import)
          cd "$AIDEOS_DIR" && exec npx tsx backend/cli.ts audio "$SUB" "$@"
          ;;
        --help|-h|help|"")
          audio_usage
          exit 0
          ;;
        *)
          audio_usage >&2
          exit 1
          ;;
      esac
      ;;
    render)
      cd "$AIDEOS_DIR" && npm run render -- "$@"
      exit 0
      ;;
    reel)
      case "${1:-}" in
        brief|check|build|--help|-h|help)
          exec "$AIDEOS_DIR/node_modules/.bin/tsx" "$AIDEOS_DIR/backend/cli.ts" reel "$@"
          ;;
        *)
          ( cd "$AIDEOS_DIR" && npm run render:reel -- "$@" )
          ;;
      esac
      exit 0
      ;;
    "render:reel")
      cd "$AIDEOS_DIR" && npm run render:reel "$@"
      exit 0
      ;;
    studio)
      cd "$AIDEOS_DIR" && npm run studio -- --port "$((AIDEOS_PORT + 100))" "$@"
      exit 0
      ;;
    frames)
      cd "$AIDEOS_DIR" && npm run frames "$@"
      exit 0
      ;;
    test)
      cd "$AIDEOS_DIR" && npm test "$@"
      exit 0
      ;;
    lint)
      cd "$AIDEOS_DIR" && npm run lint "$@"
      exit 0
      ;;
    produce|engine-test|film|direct|mcp|end-card)
      cd "$AIDEOS_DIR" && npm run backend -- "$CMD" "$@"
      exit 0
      ;;
    help|--help|-h)
      echo "Aideos: Autonomous Explainer Video Director"
      echo ""
      echo "Usage:"
      echo "  aideos               Pick a coding agent, then launch Studio (localhost:3001) and connect it"
      echo "  aideos version / which  Show channel, release, commit and checkout"
      echo "  aideos exit          Stop this channel editor dev server"
      echo "  aideos validate      Validate active film schema and print runsheet"
      echo "  aideos render        Render long-form video (videos/<slug>/renders/long.mp4)"
      echo "  aideos reel          Render vertical reel (videos/<slug>/renders/reel.mp4)"
      echo "  aideos studio        Open Remotion Studio"
      echo "  aideos frames        Render proof stills to .frames/"
      echo "  aideos test          Run full test suite"
      echo "  aideos produce       Audio-first timing spine generation"
      echo "  aideos direct <prompt>  Auto-prompt: LLM director plans and produces a draft film (--final-export renders mp4s)"
      echo "  aideos film          One call from a screenplay to a draft film (--final-export renders verified mp4s)"
      echo "  aideos gemini-review <mp4>  Gemini 3.8 Flash native video quality review"
      echo "  aideos all-check <slug>     Full check of long cut and reel in a background agent (see docs/REVIEW.md)"
      echo "  aideos review <slug|mp4>    Measured (deterministic) review of a rendered video"
      echo "  aideos character check <spec>  Validate a character spec, naming bad fields (--stamp writes its hash)"
      echo "  aideos character sheet <spec>  Render its model sheet, expression sheet and receive stills"
      echo "  aideos audio fetch [--item <id>]    Fetch background music and sound effects into shared cache"
      echo "  aideos audio verify [--json]        Verify cached audio against hash locks"
      echo "  aideos audio import <id> <file>     Import manual audio file into shared cache"
      echo "  aideos look brief|check <film>      Write or check a film's look plan (aideos look --help)"
      echo "  aideos reel brief|check|build <film> Write, check or build a condensed reel narration cut"
      echo "  aideos design check|brief|build <film>  Check, brief or build a film's bespoke design (aideos design --help)"
      echo "  aideos connect <code>       Link the studio to the coding agent in this terminal"
      echo "  aideos mcp                  Serve the production tools over MCP (stdio)"
      echo "  aideos engine-test          Run the backend engine self-test"
      echo "  aideos lint                 Run the lint gate"
      echo "  aideos exit                 Stop the local editor dev server (also: stop, down, kill)"
      echo ""
      exit 0
      ;;
  esac
fi

# Launch order (the one place it is documented): channel banner, then the agent menu, and only after the
# choice is resolved the Studio server, then the browser, then the chosen agent. Asking first keeps the
# user in the terminal: opening the browser before the menu pulls them to Chrome and back.
PORT="$AIDEOS_PORT"

# Prints the checkout root that the server answering on the channel port reports (empty when unknown).
studio_server_root() {
  curl -fsS "http://localhost:$PORT/api/release-channel" 2>/dev/null | node -e 'let s="";process.stdin.on("data", c=>s+=c);process.stdin.on("end",()=>{try{process.stdout.write(JSON.parse(s).root)}catch{process.exit(1)}})' 2>/dev/null || true
}

# Starts this checkout's editor on its channel's reserved port and waits until it answers.
start_studio() {
  echo "Starting Aideos Studio on http://localhost:$PORT..."
  ( cd "$AIDEOS_DIR/editor" && nohup npm run dev -- --port "$PORT" --strictPort > "/tmp/aideos-editor-$PORT.log" 2>&1 & )
  local ready=0 i
  for i in {1..40}; do
    if curl -fsS "http://localhost:$PORT/api/release-channel" >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.5
  done
  if [ "$ready" -ne 1 ]; then
    echo "Studio did not start; see /tmp/aideos-editor-$PORT.log" >&2
    exit 1
  fi
}

# Ends the launch cleanly when the menu is cancelled (Ctrl-C or Ctrl-D): nothing has been started yet.
cancel_launch() {
  echo ""
  echo "No agent selected. Nothing was started."
  exit 130
}

# Preflight, with no side effects: refuse another checkout's server before asking anything, instead of
# letting the user pick an agent and then quietly attaching the wrong channel.
STUDIO_RUNNING=0
if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  if [ "$(studio_server_root)" != "$AIDEOS_DIR" ]; then
    echo "Port $PORT belongs to another checkout. Stop that server first." >&2
    exit 1
  fi
  STUDIO_RUNNING=1
fi

# Interactive agent selection menu (always prompts, before the server or browser starts)
SAVED_AGENT=""
if [ -f "$CONFIG_FILE" ]; then
  SAVED_AGENT="$(cat "$CONFIG_FILE" | tr -d '[:space:]')"
fi

DEFAULT_LABEL="Claude Code [1]"
DEFAULT_VAL="claude"
if [ "$SAVED_AGENT" = "agy" ] || [ "$SAVED_AGENT" = "antigravity" ]; then
  DEFAULT_LABEL="Antigravity CLI [2] (Locked Default)"
  DEFAULT_VAL="agy"
elif [ "$SAVED_AGENT" = "pi" ]; then
  DEFAULT_LABEL="Pi Coding Agent [3] (Locked Default)"
  DEFAULT_VAL="pi"
elif [ "$SAVED_AGENT" = "codex" ]; then
  DEFAULT_LABEL="Codex CLI [4] (Locked Default)"
  DEFAULT_VAL="codex"
elif [ "$SAVED_AGENT" = "none" ]; then
  DEFAULT_LABEL="Web Studio Only [5] (Locked Default)"
  DEFAULT_VAL="none"
elif [ "$SAVED_AGENT" = "claude" ]; then
  DEFAULT_LABEL="Claude Code [1] (Locked Default)"
  DEFAULT_VAL="claude"
fi

TARGET_AGENT=""

if [ -t 0 ]; then
  trap cancel_launch INT
  while true; do
    echo ""
    echo "========================================================"
    echo "  🎬 Aideos Video Director - Connected Coding Agent"
    echo "========================================================"
    echo "  1) Claude Code (claude)"
    echo "  2) Antigravity CLI (agy)"
    echo "  3) Pi Coding Agent (pi)"
    echo "  4) Codex CLI (codex)"
    echo "  5) Web Studio only (no terminal agent)"
    echo "--------------------------------------------------------"
    echo "  [p] Hard-lock / set a permanent default"
    if [ -n "$SAVED_AGENT" ]; then
      echo "  [c] Clear locked default"
    fi
    echo "========================================================"
    read -rp "Select agent [1-5, p] (Enter for $DEFAULT_LABEL): " CHOICE < /dev/tty || cancel_launch

    case "$CHOICE" in
      1|claude)
        TARGET_AGENT="claude"
        break
        ;;
      2|agy|antigravity)
        TARGET_AGENT="agy"
        break
        ;;
      3|pi)
        TARGET_AGENT="pi"
        break
        ;;
      4|codex)
        TARGET_AGENT="codex"
        break
        ;;
      5|none|studio)
        TARGET_AGENT="none"
        break
        ;;
      p|P)
        echo ""
        echo "Select the agent to hard-lock as your permanent default:"
        echo "  1) Claude Code (claude)"
        echo "  2) Antigravity CLI (agy)"
        echo "  3) Pi Coding Agent (pi)"
        echo "  4) Codex CLI (codex)"
        echo "  5) Web Studio only"
        read -rp "Hard-lock choice [1-5]: " PCHOICE < /dev/tty || cancel_launch
        PAGENT="claude"
        case "$PCHOICE" in
          2) PAGENT="agy" ;;
          3) PAGENT="pi" ;;
          4) PAGENT="codex" ;;
          5) PAGENT="none" ;;
          *) PAGENT="claude" ;;
        esac
        mkdir -p "$CONFIG_DIR"
        echo "$PAGENT" > "$CONFIG_FILE"
        echo "✓ Hard-locked $PAGENT as default! (You will still see this prompt every launch with it pre-selected)"
        TARGET_AGENT="$PAGENT"
        break
        ;;
      c|C)
        rm -f "$CONFIG_FILE"
        echo "✓ Cleared locked default."
        SAVED_AGENT=""
        DEFAULT_LABEL="Claude Code [1]"
        DEFAULT_VAL="claude"
        ;;
      "")
        TARGET_AGENT="$DEFAULT_VAL"
        break
        ;;
      *)
        echo "Invalid choice. Please enter 1-5 or p."
        ;;
    esac
  done
  trap - INT
fi

# Fallback for non-interactive pipes
if [ -z "$TARGET_AGENT" ]; then
  TARGET_AGENT="claude"
fi

# Pair the Studio server with the chosen agent before the server is reachable. The dispatcher reads
# SESSION_FILE on every task, so recording it first means a click in the freshly opened browser can never be
# pasted into a stale pane left by an earlier launch. Web Studio only drops any stale pairing instead.
cd "$AIDEOS_DIR"
LAUNCH_MODE="standalone"
if [ "$TARGET_AGENT" = "none" ]; then
  rm -f "$SESSION_FILE"
elif [ -n "${TMUX:-}" ]; then
  LAUNCH_MODE="tmux-current"
  CURRENT_PANE="$(tmux display-message -p '#{pane_id}' 2>/dev/null || echo '')"
  cat <<EOF > "$SESSION_FILE"
{
  "agent": "$TARGET_AGENT",
  "sessionType": "tmux",
  "tmuxSession": "$TMUX_SESSION",
  "tmuxPane": "$CURRENT_PANE",
  "updatedAt": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
elif command -v tmux >/dev/null 2>&1; then
  LAUNCH_MODE="tmux-new"
  cat <<EOF > "$SESSION_FILE"
{
  "agent": "$TARGET_AGENT",
  "sessionType": "tmux",
  "tmuxSession": "$TMUX_SESSION",
  "updatedAt": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
else
  cat <<EOF > "$SESSION_FILE"
{
  "agent": "$TARGET_AGENT",
  "sessionType": "standalone",
  "updatedAt": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
fi

# Only now that the choice is resolved and recorded: start Studio if it is not already running, then open the browser.
if [ "$STUDIO_RUNNING" -ne 1 ]; then
  start_studio
fi
echo "Aideos Studio: http://localhost:$PORT/"

# Open in default browser
open "http://localhost:$PORT/" 2>/dev/null || true

# Last, hand the terminal to the chosen agent (Web Studio only has none).
if [ "$TARGET_AGENT" = "none" ]; then
  echo "🎬 Aideos Studio is active on http://localhost:$PORT/. Happy editing!"
  exit 0
fi

case "$LAUNCH_MODE" in
  tmux-current)
    echo "✨ Connected to active tmux session ($TMUX_SESSION, pane $CURRENT_PANE). Auto-prompter is active!"
    exec "$TARGET_AGENT"
    ;;
  tmux-new)
    echo "⚡ Launching $TARGET_AGENT in tmux session [$TMUX_SESSION] with Aideos Auto-Prompter..."
    if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
      echo "Attaching to existing tmux session [$TMUX_SESSION]..."
      exec tmux attach-session -t "$TMUX_SESSION"
    else
      exec tmux new-session -s "$TMUX_SESSION" -c "$AIDEOS_DIR" "$TARGET_AGENT"
    fi
    ;;
  *)
    echo "✨ Launching $TARGET_AGENT in $AIDEOS_DIR..."
    exec "$TARGET_AGENT"
    ;;
esac
