    "items": [
      {
        "id": "plate",
        "prompt": "A wide empty dark floor that fades into shadow, lit from the middle.",
        "aspect": "1:1",
        "cutout": "none",
        "sha256": "5c6f25b0c3c27e4db77339b49944fefb1104924f58450d769c332af7701d4b65"
      },
      {
        "id": "lens",
        "prompt": "One round optical lens in a dark steel ring with a softly glowing violet core.",
        "aspect": "1:1",
        "cutout": "generator-alpha",
        "sha256": "7614bf1f774fa35dd7a37e958f1e6dcb0a06e0e438d6e800f41245e81a64b52e"
      }
    ]
  },
