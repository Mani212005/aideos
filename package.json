{
  "name": "aideos",
  "version": "1.0.0",
  "description": "Explainer video as data - one canvas, one camera, two aspect ratios.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mani212005/aideos.git"
  },
  "homepage": "https://github.com/Mani212005/aideos#readme",
  "bugs": "https://github.com/Mani212005/aideos/issues",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "aideos": "./bin/aideos"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/genai": "^2.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/fiber": "9.4.0",
    "@remotion/bundler": "4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/google-fonts": "4.0.499",
    "@remotion/layout-utils": "4.0.499",
    "@remotion/media": "4.0.499",
    "@remotion/player": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "@remotion/three": "4.0.499",
    "@remotion/zod-types": "4.0.499",
    "commander": "^15.0.0",
    "culori": "4.0.2",
    "dotenv": "^17.4.2",
    "kokoro-js": "^1.2.1",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.499",
    "three": "0.180.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.499",
    "@types/culori": "^4.0.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.180.0",
    "esbuild": "0.28.1",
    "eslint": "9.19.0",
    "globals": "^14.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "ensure:generated": "bun scripts/ensure_generated.ts",
    "backend": "tsx backend/cli.ts",
    "release": "tsx scripts/release.ts release",
    "release:setup": "tsx scripts/release.ts setup",
    "studio": "remotion studio",
    "editor": "bun run --cwd editor dev",
    "validate": "tsx scripts/validate_film.ts",
    "smoke:studio": "bun scripts/smoke_studio.ts",
    "eval:visuals": "bun backend/eval/shotVisualEval.ts",
    "eval:look": "bun backend/eval/lookEval.ts",
    "review": "tsx backend/cli.ts review",
    "calibrate:review": "bun scripts/calibrate_review.ts",
    "intelligibility": "bun scripts/intelligibility/round_trip.ts",
    "validate:film": "tsx scripts/validate_film.ts",
    "test": "bun scripts/bunTest.ts \"backend/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:journeys": "bun scripts/bunTest.ts \"backend/journeys/**/*.journey.ts\"",
    "test:live": "RUN_TTS_TESTS=1 RUN_VISUAL_TESTS=1 bun scripts/bunTest.ts \"backend/live/**/*.live.ts\"",
    "test:legacy": "bun scripts/bunTest.ts \"backend/journeys/**/*.golden.ts\"",
    "goldens:native:ir": "bun scripts/native_golden_ir.ts",
    "goldens:update": "AIDEOS_GOLDEN_UPDATE=1 bun scripts/bunTest.ts \"backend/journeys/**/*.golden.ts\"",
    "ci": "bun scripts/ci.ts",
    "farm": "tsx scripts/farm.ts",
    "performance:filmstrip": "bun scripts/performance_filmstrip.ts",
    "performance:check": "bun scripts/performance_check.ts",
    "render-ir:schema": "bun scripts/render_ir_schema.ts",
    "design:check": "tsx backend/cli.ts design-check",
    "connect": "node scripts/aideos-connect.mjs",
    "test:visual": "RUN_VISUAL_TESTS=1 bun scripts/bunTest.ts backend/live/svgAnimation.live.ts",
    "render": "tsx scripts/render_active.ts Long",
    "render:reel": "tsx scripts/render_active.ts Reel",
    "typecheck": "bun scripts/typecheck_tracked.ts",
    "lint": "bun scripts/ci.ts static",
    "bundle": "remotion bundle",
    "upgrade": "remotion upgrade",
    "pretest": "bun scripts/ensure_generated.ts",
    "prelint": "bun scripts/ensure_generated.ts",
    "prestudio": "tsx scripts/ensure_generated.ts",
    "preeditor": "bun scripts/ensure_generated.ts",
    "prerender": "tsx scripts/ensure_generated.ts",
    "posttest": "bun scripts/ensure_generated.ts",
    "prerender:reel": "tsx scripts/ensure_generated.ts",
    "presmoke:studio": "bun scripts/ensure_generated.ts",
    "prevalidate": "tsx scripts/ensure_generated.ts",
    "pretest:journeys": "bun scripts/ensure_generated.ts",
    "pretest:live": "bun scripts/ensure_generated.ts",
    "pretest:legacy": "bun scripts/ensure_generated.ts",
    "pregoldens:update": "bun scripts/ensure_generated.ts",
    "prebundle": "tsx scripts/ensure_generated.ts",
    "posttest:journeys": "bun scripts/ensure_generated.ts",
    "posttest:legacy": "bun scripts/ensure_generated.ts",
    "postgoldens:update": "bun scripts/ensure_generated.ts"
  }
}
