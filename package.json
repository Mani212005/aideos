{
  "name": "aideos",
  "version": "1.0.0",
  "description": "Explainer video as data - one canvas, one camera, two aspect ratios.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mani212005/aideos.git"
  },
  "homepage": "https://github.com/Mani212005/aideos#readme",
  "bugs": "https://github.com/Mani212005/aideos/issues",
  "license": "MIT",
  "private": true,
  "bin": {
    "aideos": "./bin/aideos"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google/genai": "^2.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/fiber": "9.4.0",
    "@remotion/cli": "4.0.499",
    "@remotion/google-fonts": "4.0.499",
    "@remotion/layout-utils": "4.0.499",
    "@remotion/media": "4.0.499",
    "@remotion/three": "4.0.499",
    "@remotion/zod-types": "4.0.499",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "kokoro-js": "^1.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.499",
    "three": "0.180.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.499",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.180.0",
    "esbuild": "0.28.1",
    "eslint": "9.19.0",
    "globals": "^14.0.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "postinstall": "npm --prefix editor ci && tsx scripts/ensure_generated.ts",
    "ensure:generated": "tsx scripts/ensure_generated.ts",
    "backend": "tsx backend/cli.ts",
    "studio": "remotion studio",
    "editor": "npm --prefix editor run dev --",
    "validate": "node scripts/validate.mjs",
    "smoke:studio": "tsx scripts/smoke_studio.ts",
    "eval:visuals": "tsx backend/eval/shotVisualEval.ts",
    "eval:look": "tsx backend/eval/lookEval.ts",
    "review": "tsx backend/cli.ts review",
    "calibrate:review": "tsx scripts/calibrate_review.ts",
    "validate:film": "tsx scripts/validate_film.ts",
    "test": "node --import tsx --import ./backend/testSupport/fixtureVideosDir.ts --test --test-concurrency=1 \"backend/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:journeys": "node --import tsx --import ./backend/testSupport/fixtureVideosDir.ts --test --test-concurrency=1 --test-reporter=tap \"backend/journeys/**/*.journey.ts\"",
    "test:live": "RUN_TTS_TESTS=1 RUN_VISUAL_TESTS=1 node --import tsx --import ./backend/testSupport/fixtureVideosDir.ts --test --test-concurrency=1 \"backend/live/**/*.live.ts\"",
    "test:legacy": "node --import tsx --import ./backend/testSupport/fixtureVideosDir.ts --test --test-concurrency=1 \"backend/journeys/**/*.golden.ts\"",
    "goldens:update": "AIDEOS_GOLDEN_UPDATE=1 node --import tsx --import ./backend/testSupport/fixtureVideosDir.ts --test --test-concurrency=1 \"backend/journeys/**/*.golden.ts\"",
    "ci": "tsx scripts/ci.ts",
    "performance:filmstrip": "tsx scripts/performance_filmstrip.ts",
    "performance:check": "tsx scripts/performance_check.ts",
    "design:check": "tsx backend/cli.ts design-check",
    "connect": "node scripts/aideos-connect.mjs",
    "test:visual": "RUN_VISUAL_TESTS=1 node --import tsx --import ./backend/testSupport/fixtureVideosDir.ts --test --test-concurrency=1 backend/live/svgAnimation.live.ts",
    "frames": "node scripts/frames.mjs",
    "render": "tsx scripts/render_active.ts Long",
    "render:reel": "tsx scripts/render_active.ts Reel",
    "lint": "tsx scripts/check_headers.ts && eslint src && tsc --noEmit",
    "bundle": "remotion bundle",
    "upgrade": "remotion upgrade",
    "pretest": "npm run ensure:generated --silent",
    "prelint": "npm run ensure:generated --silent",
    "prestudio": "npm run ensure:generated --silent",
    "preeditor": "npm run ensure:generated --silent",
    "prerender": "npm run ensure:generated --silent",
    "posttest": "npm run ensure:generated --silent",
    "prerender:reel": "npm run ensure:generated --silent",
    "presmoke:studio": "npm run ensure:generated --silent",
    "prevalidate": "npm run ensure:generated --silent",
    "pretest:journeys": "npm run ensure:generated --silent",
    "pretest:live": "npm run ensure:generated --silent",
    "pretest:legacy": "npm run ensure:generated --silent",
    "pregoldens:update": "npm run ensure:generated --silent",
    "preframes": "npm run ensure:generated --silent",
    "prebundle": "npm run ensure:generated --silent",
    "posttest:journeys": "npm run ensure:generated --silent",
    "posttest:legacy": "npm run ensure:generated --silent",
    "postgoldens:update": "npm run ensure:generated --silent"
  }
}
